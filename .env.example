# ---- Backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
# Get free Gemini keys at https://aistudio.google.com (use 2 different Google accounts/projects).
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2

# SQLite file. In Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins (add your deployed Vercel URL here too).
ALLOWED_ORIGINS=http://localhost:3000

# true = honour the X-Simulate-Failure header (needed on the deployed backend for the demo).
ENABLE_FAILURE_SIMULATION=true

# Optional
MODEL=gemini/gemini-3.5-flash-lite
REQUEST_TIMEOUT=30

# ---- Frontend (build-time) ----
# URL the browser uses to reach the backend.
VITE_API_URL=http://localhost:8000

# ---- Optional: automatic daily slang refresh from Grok (xAI) ----
XAI_API_KEY=
SLANG_MODEL=xai/grok-4
SLANG_REFRESH_HOURS=24
